cat > .gitignore << 'EOF'
# Diretórios de build e saída
/cmake-build-debug/
/bin/

# Arquivos objeto
**/*.o
**/*.obj

# Arquivos de dados gerados
**/*.dat
**/*_index.dat
**/*_random.dat
**/*_random_index.dat

# Arquivos de projeto do CLion
/.idea/

# Arquivos temporários do macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Arquivos gerados pelo CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
EOF